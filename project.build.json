{
  "$schema": "https://raw.githubusercontent.com/EvotecIT/PSPublishModule/main/Schemas/project.build.schema.json",
  "RootPath": ".",
  "IncludeProjects": [ "Globalping" ],
  "Configuration": "Release",
  "OutputPath": "Artefacts/NuGet",
  "UpdateVersions": false,
  "Build": true,
  "StageNuget": true,
  "PublishNuget": false,
  "CreateReleaseZip": false,
  "IncludeSymbols": true,
  "SignAssemblies": true,
